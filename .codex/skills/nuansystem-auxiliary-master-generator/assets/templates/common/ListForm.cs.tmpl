    public {{PLURAL}}Form() { viewModel = null!; session = null!; ConfigureWindow(); WirePermissions(); }
    public {{PLURAL}}Form({{PLURAL}}ViewModel viewModel, ApiSession session, IGridColumnSettingsClient columnSettingsClient)
    { this.viewModel = viewModel; this.session = session; ConfigureWindow(); ConfigureColumnPersonalization(columnSettingsClient, FormKey); WirePermissions(); }
    protected override async Task LoadDataAsync()
    { if (viewModel is null) return; await RunWithBusyStateAsync(async () => { await viewModel.LoadAsync(); SetGridData(viewModel.Items); await ApplyColumnSettingsAsync(); }); }
    protected override async Task CreateAsync()
    { using var form = new {{SINGULAR}}EditForm(); if (form.ShowDialog(this) != DialogResult.OK) return; await viewModel.CreateAsync(form.Request); await LoadDataAsync(); }
    protected override async Task EditAsync()
    { if (SelectedGridItem<{{SINGULAR}}Item>() is not { } selected) return; var item = await viewModel.GetByIdAsync(selected.Id); using var form = new {{SINGULAR}}EditForm(item); if (form.ShowDialog(this) != DialogResult.OK) return; await viewModel.UpdateAsync(item.Id, form.Request); await LoadDataAsync(); }
    protected override async Task CopyAsync()
    { if (SelectedGridItem<{{SINGULAR}}Item>() is not { } selected) return; var item = await viewModel.GetByIdAsync(selected.Id); using var form = new {{SINGULAR}}EditForm(item, true); if (form.ShowDialog(this) != DialogResult.OK) return; await viewModel.CreateAsync(form.Request); await LoadDataAsync(); }
    protected override async Task DeleteAsync()
    { if (SelectedGridItem<{{SINGULAR}}Item>() is not { } item || !Confirm($"¿Eliminar {item.{{CODE_FIELD}}}?") ) return; await viewModel.DeleteAsync(item.Id); await LoadDataAsync(); }
    protected override Task HistoryAsync()
    {
        if (SelectedGridItem<{{SINGULAR}}Item>() is not { } item) return Task.CompletedTask;
        using var form = new RecordHistoryForm("Historial de {{TITLE}}", $"{item.{{CODE_FIELD}}} - {item.{{NAME_FIELD}}}", async ct =>
        {
            var changes = await viewModel.GetHistoryAsync(item.Id, ct);
            return changes.Select(change => new SecurityChangeItem(0, "{{SINGULAR}}", item.Id.ToString(), change.Action, change.FieldName, change.OldValue, change.NewValue, change.UserId, change.UserName, "API", change.CreatedAt)).ToList();
        });
        form.ShowDialog(this);
        return Task.CompletedTask;
    }
    protected override void ConfigureGridColumns()
    {
        base.ConfigureGridColumns();
        foreach (DevExpress.XtraGrid.Columns.GridColumn column in GridView.Columns) column.Visible = false;
