CREATE OR ALTER PROCEDURE dbo.SP_NA_POST_{{ENTITY_CODE}}_SYNC_APPLY
 @GlobalId uniqueidentifier,{{SQL_PARAMETERS}},@IsDeleted bit,@UpdatedAt datetime2(0)=NULL
AS
BEGIN
 SET NOCOUNT ON; SET XACT_ABORT ON;
 DECLARE @Id int=(SELECT Id FROM {{TABLE}} WITH(UPDLOCK,HOLDLOCK) WHERE GlobalId=@GlobalId);
 IF @Id IS NULL
 BEGIN
  INSERT {{TABLE}}(GlobalId,{{SQL_INSERT_COLUMNS}},IsDeleted,CreatedAt,UpdatedAt)
  VALUES(@GlobalId,{{SQL_INSERT_VALUES}},@IsDeleted,COALESCE(@UpdatedAt,SYSUTCDATETIME()),@UpdatedAt);
  SET @Id=CONVERT(int,SCOPE_IDENTITY());
 END
 ELSE
  UPDATE {{TABLE}} SET {{SQL_UPDATE_SET}},IsDeleted=@IsDeleted,UpdatedAt=COALESCE(@UpdatedAt,SYSUTCDATETIME()) WHERE Id=@Id;
 INSERT dbo.AuditCatalogChanges(EntityName,RecordId,[Action],FieldName,OldValue,NewValue,UserName,[Source])
 VALUES(N'{{ENTITY_CODE}}',CONVERT(nvarchar(80),@Id),N'SYNC',N'GlobalId',NULL,CONVERT(nvarchar(max),@GlobalId),N'MasterBranchSyncWorker',N'MasterBranchSyncWorker');
 SELECT 1 ResultCode,@Id ItemId;
END;
GO
