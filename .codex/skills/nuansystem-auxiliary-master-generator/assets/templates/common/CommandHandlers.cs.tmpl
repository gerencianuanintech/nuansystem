public sealed class Create{{SINGULAR}}CommandHandler(I{{SINGULAR}}Repository repository, ITransactionRunner transactionRunner)
    : ICommandHandler<Create{{SINGULAR}}Command, {{SINGULAR}}Dto>
{
    public Task<Result<{{SINGULAR}}Dto>> Handle(Create{{SINGULAR}}Command request, CancellationToken ct) =>
        transactionRunner.ExecuteInTenantTransactionAsync(async (connection, transaction, token) =>
        {
            var code = request.{{CODE_FIELD}}.Trim().ToUpperInvariant();
            if (await repository.ExistsByCodeAsync(code, null, connection, transaction, token))
                return Result<{{SINGULAR}}Dto>.Failure("El código ya existe.", [new ApiError("{{SINGULAR}}CodeAlreadyExists", "El código ya existe.", nameof(request.{{CODE_FIELD}}))]);
            var data = new Create{{SINGULAR}}Data(Guid.NewGuid(), {{REQUEST_ARGUMENTS}}, request.AuditUserId, request.AuditUserName);
            var id = await repository.CreateAsync(data, connection, transaction, token);
            var item = id > 0 ? await repository.GetByIdAsync(id, connection, transaction, token) : null;
            return item is null ? Result<{{SINGULAR}}Dto>.Failure("No se pudo crear {{TITLE}}.") : Result<{{SINGULAR}}Dto>.Success(item);
        }, ct);
}

public sealed class Update{{SINGULAR}}CommandHandler(I{{SINGULAR}}Repository repository, ITransactionRunner transactionRunner)
    : ICommandHandler<Update{{SINGULAR}}Command, {{SINGULAR}}Dto>
{
    public Task<Result<{{SINGULAR}}Dto>> Handle(Update{{SINGULAR}}Command request, CancellationToken ct) =>
        transactionRunner.ExecuteInTenantTransactionAsync(async (connection, transaction, token) =>
        {
            if (await repository.GetByIdAsync(request.Id, connection, transaction, token) is null)
                return Result<{{SINGULAR}}Dto>.Failure("Registro no encontrado.");
            var data = new Update{{SINGULAR}}Data(request.Id, {{REQUEST_ARGUMENTS}}, request.AuditUserId, request.AuditUserName);
            var changed = await repository.UpdateAsync(data, connection, transaction, token);
            var item = changed > 0 ? await repository.GetByIdAsync(request.Id, connection, transaction, token) : null;
            return item is null ? Result<{{SINGULAR}}Dto>.Failure("No se pudo actualizar {{TITLE}}.") : Result<{{SINGULAR}}Dto>.Success(item);
        }, ct);
}

public sealed class Delete{{SINGULAR}}CommandHandler(I{{SINGULAR}}Repository repository, ITransactionRunner transactionRunner)
    : ICommandHandler<Delete{{SINGULAR}}Command, bool>
{
    public Task<Result<bool>> Handle(Delete{{SINGULAR}}Command request, CancellationToken ct) =>
        transactionRunner.ExecuteInTenantTransactionAsync(async (connection, transaction, token) =>
        {
            var changed = await repository.DeleteAsync(request.Id, request.AuditUserId, request.AuditUserName, connection, transaction, token);
            return changed > 0 ? Result<bool>.Success(true) : Result<bool>.Failure("No se pudo eliminar {{TITLE}}.");
        }, ct);
}
