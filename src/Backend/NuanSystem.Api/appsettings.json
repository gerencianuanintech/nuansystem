{
  "MasterDatabase": {
    "DatabaseName": "NuanSystem_Master"
  },
  "DatabaseInitialization": {
    "InitializeMasterOnStartup": false
  },
  "Security": {
    "EncryptionKey": ""
  },
  "Jwt": {
    "Issuer": "NuanSystem",
    "Audience": "NuanSystem.WinForms",
    "SigningKey": "",
    "ExpirationMinutes": 60
  },
  "Sap": {
    "ServiceLayer": {
      "BaseUrl": ""
    }
  },
  "ServiceLayer": {
    "HttpTimeoutSeconds": 100,
    "IgnoreSslErrors": false
  },
  "Geocoding": {
    "Provider": "Google",
    "Google": {
      "ApiKey": "",
      "GeocodingBaseUrl": "https://maps.googleapis.com/maps/api/geocode/json",
      "StaticMapBaseUrl": "https://maps.googleapis.com/maps/api/staticmap",
      "Language": "es",
      "Region": "ec",
      "StaticMapSize": "600x350",
      "StaticMapZoom": 16,
      "StaticMapScale": 2
    }
  },
  "ConnectionStrings": {
    "SqlServerAdmin": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
