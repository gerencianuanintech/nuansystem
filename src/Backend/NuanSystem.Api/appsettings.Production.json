{
  "DatabaseInitialization": {
    "InitializeMasterOnStartup": false
  },
  "SqlConnectionPolicy": {
    "Encrypt": true,
    "TrustServerCertificate": false
  },
  "Swagger": {
    "Enabled": false
  },
  "Serilog": {
    "FilePath": "logs/nuansystem-api-.log",
    "RetainedFileCountLimit": 60,
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": ""
}
