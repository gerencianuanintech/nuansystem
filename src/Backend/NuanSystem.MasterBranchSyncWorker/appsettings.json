{
  "MasterDatabase": {
    "DatabaseName": "NuanSystem_Master"
  },
  "ConnectionStrings": {
    "SqlServerAdmin": ""
  },
  "Security": {
    "EncryptionKey": ""
  },
  "SqlConnectionPolicy": {
    "Encrypt": true,
    "TrustServerCertificate": false
  },
  "MasterBranchSyncWorker": {
    "Enabled": false,
    "WorkerInstance": "master-branch-sync-worker",
    "BatchSize": 50,
    "LockMinutes": 5,
    "EmptyQueueDelaySeconds": 10,
    "ErrorDelaySeconds": 30,
    "SkeletonMode": true,
    "SkeletonModeBehavior": "ObserveOnly",
    "EnabledEntityAppliers": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
